# Optional: point ENV_FILE at another dotenv file. Process environment values
# always override values read from that file.
# ENV_FILE=.env

# Application identity. These four values are required. APP_URL is the public
# base URL advertised in OpenAPI; APP_PORT is the local listen port.
APP_NAME=golang-clean-architecture
APP_ENV=development
APP_URL=http://localhost:3000
APP_PORT=3000

# Fiber lifecycle and proxy settings.
APP_SHUTDOWN_TIMEOUT=10s
APP_TRUSTED_PROXIES=127.0.0.1,::1

# CORS. Never combine ALLOW_CREDENTIALS=true with ALLOW_ORIGINS=*.
ALLOW_ORIGINS=*
ALLOW_CREDENTIALS=false

# Structured logging. LOG_FORMAT accepts json or console. LOG_OUTPUT accepts a
# comma-separated combination of stdout, stderr, and file.
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_FILE=logs/app.log
LOG_ROTATION_MAX_SIZE_MB=50
LOG_ROTATION_MAX_BACKUPS=5
LOG_ROTATION_MAX_AGE_DAYS=7
LOG_ROTATION_COMPRESS=true

# Huma serves the OpenAPI document at /openapi.json. Set this true to also
# expose the interactive documentation at /docs.
DOCS_ENABLED=true

# Auth-service v2 gRPC integration. Protected /api routes require auth when
# enabled. AUTH_ENABLED=false is intended for contract generation or isolated
# bootstrap diagnostics; protected routes then return 503.
AUTH_ENABLED=true
AUTH_SERVICE_GRPC_TARGET=127.0.0.1:50051
SERVICE_ID=golang-clean-architecture
INTERNAL_SECRET=replace-with-the-shared-internal-secret

# Transitional single PostgreSQL connection. The upcoming multi-DB manager will
# replace this composition seam; all application queries already use GORM.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-database-password
DB_NAME=golang_clean_architecture
DB_SSLMODE=disable
DB_POOL_IDLE=10
DB_POOL_MAX=100
DB_POOL_LIFETIME=5m

# Kafka producer/worker settings. Bootstrap servers are comma-separated.
KAFKA_PRODUCER_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_GROUP_ID=golang-clean-architecture
KAFKA_AUTO_OFFSET_RESET=earliest
